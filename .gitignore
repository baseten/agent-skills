__pycache__/
*.pyc

# Generated at install by scripts/refresh_shared_rules.sh from rules/. Never
# committed to main: the source is rules/, and a committed copy is a second
# one. The plugin's release branch carries them, rebuilt and never edited.
skills/*/references/

# The install stamp bootstrap.sh writes into each INSTALLED skill. Only the
# plugin release build writes one into a checkout, in CI; ~/.claude/skills can
# be a symlink into one, and a stamp committed to main would claim a revision
# for every future install.
skills/*/.source
